#!/bin/bash
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	if command -v systemctl >/dev/null 2>&1; then
		systemctl disable buscalogo-registry.service >/dev/null 2>&1 || true
		systemctl daemon-reload || true
	fi
	rm -rf /opt/buscalogo-registry
	# Dados (identidade Ygg / ledger) ficam em /var/lib até purge.
	if [ "$1" = "purge" ]; then
		rm -rf /var/lib/buscalogo-registry
	fi
fi
