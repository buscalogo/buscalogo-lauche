#!/bin/bash
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
	if command -v systemctl >/dev/null 2>&1; then
		systemctl disable buscalogo-agent.service >/dev/null 2>&1 || true
		systemctl daemon-reload || true
	fi
	rm -rf /opt/buscalogo
	# Dados (identidade / CouchDB / sites) ficam até purge.
	if [ "$1" = "purge" ]; then
		rm -rf /var/lib/buscalogo-agent
	fi
fi
