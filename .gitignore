dist/buscalogo-agent-win/
dist/msi-stage/
dist/deb/
dist/deb-registry-*/
dist/deb-agent-server-*/
dist/buscalogo-registry_*
dist/buscalogo-agentd-server-*
dist/*.deb
dist/*.msi
dist/*.zip
dist/*.deb.old
dist/*.old
dist/*.tar.gz

