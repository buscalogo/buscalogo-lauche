/buscalogo-agent
buscalogo-agent
/agent
agent
*.exe
*.test
*.out
coverage.out
coverage.html

# --- Dados em runtime (config, senhas, CouchDB, binários extraídos) ---
data/

# Nunca versionar chave da CA (público rootCA.pem pode ir em internal/ca/certs/)
**/rootCA-key.pem
internal/ca/certs/*-key.pem
# *.pem abaixo ignora tudo; liberar só o certificado público embutido no Agent/deb
!internal/ca/certs/rootCA.pem

# --- Binários embutidos (make assets / make assets-couchdb) ---
assets/linux/coredns
assets/linux/yggdrasil
assets/linux/couchdb/
!assets/linux/MANIFEST
assets/windows/coredns.exe
assets/windows/yggdrasil.exe
assets/windows/wintun.dll
!assets/windows/MANIFEST
!assets/windows/.gitkeep

